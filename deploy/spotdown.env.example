# Optional tunables for deploy/compose.yaml: copy to spotdown.env next to compose.yaml and
# uncomment what you change. Every value shown is the default. Placeholders only: this file never
# holds the service key (that is the Docker secret file) or any other secret.
#
# Fixed by compose.yaml and not set here: SERVICE_MODE, SERVE_UI, SERVICE_KEY_FILE, DATA_DIR,
# REDIS_URL. docs/contract-v2.md describes each setting.

# The web UI (ADR 0004): off unless set to on; the image and compose.yaml leave it off. on serves
# the static page next to /v2 to every caller on the service network (the page asks for the service
# key and keeps it in memory only). Set it only where that page should be exposed. Never leave it
# empty (SPOTDOWN_UI=) and never wire it as ${SPOTDOWN_UI:-}: an empty value stops the start-up.
#SPOTDOWN_UI=off

# Exact DNS names the `url` source may fetch from (https only, comma separated). Empty = off.
#URL_ALLOWED_HOSTS=

# The UI image's caller key (ADR 0005) is a secrets file, UI_SERVICE_KEY_FILE, never set here;
# mounting it is wired in deploy/compose.yaml by #79. POST /v2/spotify/resolve needs no Spotify
# setting at all.

# YouTube sourcing (POST /v2/match and source_ref youtube:...). Off by default; turning it on is
# the operator's terms-of-service decision (README, "Service mode").
#ALLOW_YTDLP_SOURCING=false
#SOURCE_SEARCH_RESULTS=5
#MATCH_CONCURRENCY=4

# Per file, whatever the caller declares: 60 MiB.
#MAX_UPLOAD_BYTES=62914560
#URL_FETCH_TIMEOUT_S=120
#UPLOAD_TTL_S=3600

# Analysis sandbox rlimits, inside the container's own ceiling.
#ANALYSIS_MAX_MEMORY_MB=3072
#ANALYSIS_MAX_CPU_S=600
#ANALYSIS_WALL_TIMEOUT_S=900
#ANALYSIS_MAX_DECODED_S=1200
#ANALYSIS_MAX_DECODE_S=120

# Retention (ADR 0040 section 7 in classbeat): 3 days and 90 days.
#GLOBAL_REFERENCE_TTL_S=259200
#GLOBAL_ANALYSIS_TTL_S=7776000
