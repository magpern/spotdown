# Optional tunables for the ui service of deploy/compose.yaml: copy to spotdown-ui.env next to
# compose.yaml and uncomment what you change. Every value shown is the default. Placeholders only:
# this file never holds the UI's backend key (that is the Docker secret file) or the access token.
#
# Fixed by compose.yaml and not set here: SPOTDOWN_BACKEND_URL, SPOTDOWN_BACKEND_KEY_FILE,
# UI_DATA_DIR. spotdown_ui/README.md describes each setting.
#
# The access token is generated once in the ui's data volume (read it with
# `docker compose exec ui cat /data/ui_token`, then sign in at /login).

# The Host names browsers use (names or IP literals, no port, comma separated). Behind a reverse
# proxy, its public name, e.g. spotdown.example.org.
#UI_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# The exact http(s)://host[:port] browsers use behind a reverse proxy, e.g.
# https://spotdown.example.org. Empty: http:// plus the request's Host.
#UI_PUBLIC_ORIGIN=

# Uploads and the mp3 relay.
#MAX_UPLOAD_BYTES=62914560
#UI_UPLOAD_READ_S=150
#UI_MAX_AUDIO_BYTES=209715200
#UI_BACKEND_TIMEOUT_S=30
