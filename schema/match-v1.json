{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotdown.invalid/schema/match-v1.json",
  "title": "spotdown match result v1",
  "description": "Result of matching one track's metadata to source candidates, without downloading. POST /v2/match returns {\"results\": [match-v1, ...]} in request order. A cached analysis id is free to report; a miss never starts an analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_ref",
    "status",
    "alternates"
  ],
  "properties": {
    "schema_version": {
      "const": "match-v1"
    },
    "client_ref": {
      "type": "string",
      "description": "Opaque, echoed from the request."
    },
    "status": {
      "enum": [
        "matched",
        "not_found",
        "uncertain",
        "source_unavailable",
        "provider_error",
        "rate_limited"
      ]
    },
    "retry_after_s": {
      "type": "number",
      "minimum": 0,
      "description": "Present only when status is rate_limited."
    },
    "best": {
      "$ref": "#/$defs/candidate"
    },
    "alternates": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "cached_analysis_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Analysis already cached for the best candidate within the caller's scope, if any."
    },
    "matcher_version": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "matched",
              "uncertain"
            ]
          }
        }
      },
      "then": {
        "required": [
          "best",
          "matcher_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rate_limited"
          }
        }
      },
      "then": {
        "required": [
          "retry_after_s"
        ]
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recording_match_confidence",
        "band",
        "duration_s",
        "duration_delta_s",
        "duration_check"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z]+:.+$",
          "description": "<kind>:<ref>, for example youtube:<video id>."
        },
        "recording_match_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "band": {
          "enum": [
            "confident",
            "uncertain",
            "not_same"
          ],
          "description": "confident >= 0.85, uncertain 0.6 to 0.85, not_same below 0.6. Tuned on the eval set."
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "duration_delta_s": {
          "type": "number",
          "description": "Candidate minus requested duration."
        },
        "duration_check": {
          "enum": [
            "ok",
            "tolerable",
            "rejected"
          ],
          "description": "abs delta <= 2 s ok, <= 5 s tolerable, above 5 s rejected."
        },
        "analysis_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
