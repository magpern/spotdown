# Local development of the backend (README, "Local development"). The UI image has its own
# settings (spotdown_ui/README.md). Placeholders only: never a key, token or secret here.
#
# SERVICE_MODE, SERVE_UI and SPOTDOWN_UI are deprecated and ignored (spotdown#79): there is no mode
# and the backend never serves a UI. The api logs one warning naming any that are set.

# ---- Server ----
# Where the service database, uploads, work files and mp3s live.
DATA_DIR=./data
# Redis connection shared by the API and the worker.
REDIS_URL=redis://localhost:6379/0

# ---- Spotify link resolution (POST /v2/spotify/resolve) ----
# Optional. With SPOTIFY_CLIENT_ID and the secrets file below it uses the official Web API (full
# playlists, ISRC); with neither it reads Spotify's public pages on open.spotify.com. One alone
# stops the start-up. A path, never the secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET_FILE=

# ---- Audio sourcing (READ THE README) ----
# YouTube sourcing (yt-dlp: the `youtube` source, POST /v2/match and POST /v2/audio) is ON by
# default. Downloading copyrighted audio you have no rights to is infringement and violates
# site/Spotify ToS. Set it false to turn every YouTube path off (422 source_disabled) and use
# uploads or the `url` source (content you own / CC / licensed).
# Turning it on accepts a terms-of-service risk and is the operator's decision.
# UPGRADING: an unset flag used to mean off and now means on; set it explicitly (false = as before).
ALLOW_YTDLP_SOURCING=true
# ytsearchN: how many candidates to consider when matching a Spotify track to a source.
SOURCE_SEARCH_RESULTS=5
# POST /v2/match: how many tracks of one batch are searched at the same time.
MATCH_CONCURRENCY=4

# ---- The backend (docs/contract-v2.md) ----
# Only /v2 (behind a caller key) and /healthz; temporary analysis audio is deleted after every job.
# A secrets file holding classbeat's service key (at least 32 characters). Required: the api does
# not start without it; the worker needs none. Never the key itself.
SERVICE_KEY_FILE=./secrets/spotdown_service_key
# Optional: a secrets file with the UI image's own caller key (ADR 0005): at least 32 characters,
# different from the key above, the same rights on /v2. Empty = only the key above is accepted.
UI_SERVICE_KEY_FILE=
# Exact DNS names the `url` source may fetch from (https only, comma separated). Empty = off.
URL_ALLOWED_HOSTS=
# Per file (uploads, url and youtube downloads), whatever the caller declares: 60 MiB.
MAX_UPLOAD_BYTES=62914560
URL_FETCH_TIMEOUT_S=120
UPLOAD_TTL_S=3600
# POST /v2/audio (ADR 0005): an mp3 is kept this long after the last job that handed it out, then
# swept. Default a day, at least 600 seconds.
AUDIO_TTL_S=86400
# Analysis sandbox rlimits, inside the container's ceiling.
ANALYSIS_MAX_MEMORY_MB=3072
ANALYSIS_MAX_CPU_S=600
ANALYSIS_WALL_TIMEOUT_S=900
ANALYSIS_MAX_DECODED_S=1200
# Wall time for checking and decoding one file in the sandbox (above 0).
ANALYSIS_MAX_DECODE_S=120
# Lifetime in seconds of the global rows holding catalogue-derived references (the match record of
# a chosen video, the reference of a global alignment; classbeat ADR 0040 §7). Default 3 days.
GLOBAL_REFERENCE_TTL_S=259200
# Seconds a global (public-source) analysis may go unread before it is purged (ADR 0040 §7). Default
# 90 days; at least one day.
GLOBAL_ANALYSIS_TTL_S=7776000
# Seconds a scoped analysis may go unread (and a scoped job record unchanged) before it is purged;
# an analysis of an older analyzer version goes at once (spotdown#40). Default 90 days; at least
# one day.
SCOPED_RETENTION_TTL_S=7776000
