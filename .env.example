# ---- Server ----
# Public base URL clients use to reach this server (used to build download_url).
PUBLIC_BASE_URL=http://localhost:8000
# Where finished files + the cache DB live.
DATA_DIR=./data
# Redis connection shared by the API and the worker.
REDIS_URL=redis://localhost:6379/0
# false = backend only: serve the API but not the web UI at GET /.
SERVE_UI=true
# Standalone UI (ADR 0002, ADR 0003): the Host names it is opened under (any port; IPv6
# bracketed) and, behind a TLS proxy, its one public origin (https://host[:port]).
UI_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
UI_PUBLIC_ORIGIN=
# Local-file analysis in the UI: the deadline on reading one upload (60 MiB in 150 s).
STANDALONE_UPLOAD_READ_S=150

# ---- Conversion defaults ----
DEFAULT_BITRATE=320        # kbps for mp3
DEFAULT_FORMAT=mp3         # mp3 | m4a
FILE_TTL_HOURS=24          # informational; cleanup is left to you (cron/worker)
MAX_DURATION_DRIFT_S=4     # reject a source whose length differs from Spotify's by more than this

# ---- Spotify metadata (official Web API, client-credentials) ----
# Create an app at https://developer.spotify.com/dashboard to get these.
# Used for metadata ONLY (title/artist/album/ISRC/cover). Spotify does not serve audio here.
# If left blank, the server falls back to open.spotify.com oEmbed (title + cover only).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Audio sourcing (READ THE README) ----
# yt-dlp sourcing from a Spotify URL (search a public site for a matching track) is OFF by default.
# Downloading copyrighted audio you have no rights to is infringement and violates site/Spotify ToS.
# Leave this false and use `source_url` (content you own / CC / public-domain / licensed) to test the pipeline.
ALLOW_YTDLP_SOURCING=false
# Also gates the service-mode `youtube` source and POST /v2/match (422 source_disabled when false).
# ytsearchN: how many candidates to consider when matching a Spotify track to a source.
SOURCE_SEARCH_RESULTS=5
# POST /v2/match: how many tracks of one batch are searched at the same time.
MATCH_CONCURRENCY=4

# ---- Service mode (docs/contract-v2.md) ----
# true = serve only /v2 (behind the service key) and /healthz: no UI, /files, /api/v1, Spotify
# resolution or CORS; temporary audio is deleted at the end of every job.
SERVICE_MODE=false
# A secrets file holding the one shared service key (at least 32 characters). Never the key itself.
SERVICE_KEY_FILE=/run/secrets/spotdown_service_key
# Exact DNS names the `url` source may fetch from (https only, comma separated). Empty = off.
URL_ALLOWED_HOSTS=
# Per file (uploads, url and youtube downloads), whatever the caller declares: 60 MiB.
MAX_UPLOAD_BYTES=62914560
URL_FETCH_TIMEOUT_S=120
UPLOAD_TTL_S=3600
# Analysis sandbox rlimits, inside the container's ceiling.
ANALYSIS_MAX_MEMORY_MB=3072
ANALYSIS_MAX_CPU_S=600
ANALYSIS_WALL_TIMEOUT_S=900
ANALYSIS_MAX_DECODED_S=1200
# Wall time for checking and decoding one file in the sandbox (above 0).
ANALYSIS_MAX_DECODE_S=120
# Lifetime in seconds of the global rows holding catalogue-derived references (the match record of
# a chosen video, the reference of a global alignment; classbeat ADR 0040 §7). Default 3 days.
GLOBAL_REFERENCE_TTL_S=259200
# Seconds a global (public-source) analysis may go unread before it is purged (ADR 0040 §7). Default
# 90 days; at least one day.
GLOBAL_ANALYSIS_TTL_S=7776000
